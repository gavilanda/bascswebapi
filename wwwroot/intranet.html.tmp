  /* Filtros de la lista de pre-remitos: etiqueta chica arriba de cada control. */
  .filtro-campo { display:flex; flex-direction:column; gap:2px; }
  .filtro-campo > span { font-size:12px; color:var(--txt2); }
  .filtro-campo input, .filtro-campo select { padding:7px 9px; font-size:13px; width:auto; }
  /* El botón "Nuevo" se alinea con la fila de inputs (no con las etiquetas). */
  .filtros > button { padding:7px 16px; font-size:13px; align-self:flex-end; }