<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Mi cuenta — Portal de Clientes</title>
<style>
  :root {
    --borde:#e4e4e7; --txt:#18181b; --txt2:#71717a; --azul:#2563eb;
    --bg:#f6f6f7; --rojo:#dc2626; --verde:#16a34a; --activo:#eef2ff; --activotxt:#3730a3;
  }
  * { box-sizing: border-box; }
  body { font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    margin:0; background:var(--bg); color:var(--txt); }
  header { background:#fff; border-bottom:1px solid var(--borde); padding:16px 24px;
    display:flex; justify-content:space-between; align-items:center; }
  header h1 { font-size:16px; margin:0; font-weight:600; }
  .sub { color:var(--txt2); font-size:13px; }
  main { max-width:1500px; margin:24px auto; padding:0 24px; }
  .card { background:#fff; border:1px solid var(--borde); border-radius:10px;
    padding:20px; margin-bottom:20px; }
  .card h2 { font-size:15px; margin:0 0 14px; font-weight:600; }
  /* Login compacto: tarjeta angosta y centrada, al tamaño de los campos */
  #vistaLogin { max-width:360px; margin:48px auto; }
  label { display:block; font-size:13px; color:var(--txt2); margin:10px 0 4px; }
  input { width:100%; padding:9px 10px; border:1px solid var(--borde);
    border-radius:7px; font-size:14px; background:#fff; }
  button { background:var(--azul); color:#fff; border:none; padding:9px 16px;
    border-radius:7px; font-size:14px; cursor:pointer; }
  button.sec { background:#fff; color:var(--txt); border:1px solid var(--borde); }
  button[disabled] { opacity:.5; cursor:not-allowed; }
  table { width:100%; border-collapse:collapse; font-size:14px; }
  th,td { padding:10px 8px; border-bottom:1px solid var(--borde); vertical-align:middle; }
  th { color:var(--txt2); font-weight:500; font-size:13px; text-align:left; }
  td.num, th.num { text-align:right; white-space:nowrap; }
  td.acum { text-align:right; white-space:nowrap; font-weight:600; }
  .cuotas { color:var(--txt2); font-size:12px; }
  .msg { font-size:13px; padding:9px 12px; border-radius:7px; margin-top:12px; display:none; }
  .msg.err { background:#fde8e8; color:var(--rojo); display:block; }
  .msg.ok { background:#e7f6ec; color:var(--verde); display:block; }
  .hidden { display:none !important; }
  .topinfo { font-size:13px; color:var(--txt2); margin-right:10px; }
  .layout { display:flex; gap:20px; align-items:flex-start; }
  .sidebar { width:210px; flex:0 0 210px; background:#fff; border:1px solid var(--borde);
    border-radius:10px; padding:8px; }
  .sidebar a { display:block; padding:10px 12px; border-radius:7px; font-size:14px;
    color:var(--txt); cursor:pointer; user-select:none; }
  .sidebar a:hover { background:var(--bg); }
  .sidebar a.activo { background:var(--activo); color:var(--activotxt); font-weight:600; }
  .contenido { flex:1; min-width:0; }
  @media (max-width: 680px) {
    .layout { flex-direction:column; }
    .sidebar { width:100%; flex-basis:auto; }
  }
  .resumen { display:flex; justify-content:space-between; align-items:flex-start;
    flex-wrap:wrap; gap:14px; margin-bottom:6px; }
  .resumen .montos { text-align:right; }
  .saldo { font-size:24px; font-weight:700; }
  .saldo.deuda { color:var(--rojo); }
  .saldo.aldia { color:var(--verde); }
  .actu { font-size:12px; color:var(--txt2); margin-top:2px; }
  .vacio { color:var(--txt2); font-size:14px; padding:16px 4px; }
  .datos { display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:4px 24px; margin:0; }
  .datos .item dt { font-size:12px; color:var(--txt2); margin-top:12px; }
  .datos .item dd { margin:2px 0 0; font-size:15px; }
  .placeholder { color:var(--txt2); font-size:14px; line-height:1.5; }
  .volver { display:inline-block; color:var(--azul); cursor:pointer; font-size:13px; margin-bottom:12px; }
  .detgrid { display:flex; flex-wrap:wrap; gap:6px 28px; margin-bottom:14px; }
  .par { font-size:14px; }
  .par .parlbl { color:var(--txt2); margin-right:6px; }
  .dettotales { margin-top:16px; display:flex; flex-direction:column; align-items:flex-end; gap:4px; }
  .dettotales .par { font-size:15px; }
  .dettotales .par.grande { font-size:18px; font-weight:700; margin-top:6px; }
  /* Comprobante clickeable en la cuenta corriente */
  .lnk-comp { color:var(--azul); cursor:pointer; text-decoration:none; }
  .lnk-comp:hover { text-decoration:underline; }
  /* Identificación de base (cuenta corriente consolidada BARK + PRUEBAB) */
  .basebadge { font-size:11px; padding:2px 7px; border-radius:6px; font-weight:600; white-space:nowrap; }
  .basebadge.BARK { background:#dbeafe; color:#1e40af; }
  .basebadge.PRUEBAB { background:#e7f6ec; color:#15803d; }
  #cuerpoCC tr.base-BARK td:first-child { box-shadow: inset 3px 0 0 #2563eb; }
  #cuerpoCC tr.base-PRUEBAB td:first-child { box-shadow: inset 3px 0 0 #16a34a; }
  .leyenda-bases { display:flex; gap:14px; align-items:center; font-size:12px; color:var(--txt2); margin:2px 0 12px; flex-wrap:wrap; }
  .base-check { display:inline-flex; align-items:center; gap:5px; cursor:pointer; user-select:none; color:var(--txt); }
  .leyenda-bases input[type="checkbox"] { width:auto; padding:0; margin:0; cursor:pointer; accent-color:var(--azul); }
  .aviso { background:#fef9c3; color:#854d0e; font-size:13px; padding:9px 12px; border-radius:7px; margin-top:12px; }
  /* Barra de consulta de staff (búsqueda de clientes) */
  .staff-res { border:1px solid var(--borde); border-radius:8px; margin-top:8px; max-height:280px; overflow:auto; }
  .staff-res .item { padding:9px 12px; cursor:pointer; border-bottom:1px solid var(--borde); font-size:14px; }
  .staff-res .item:last-child { border-bottom:none; }
  .staff-res .item:hover { background:var(--activo); }
  .staff-res .item .cuit { color:var(--txt2); font-size:12px; margin-left:6px; }
  .staff-res .vacio { padding:10px 12px; color:var(--txt2); font-size:13px; }
  .staff-elegido { margin-top:10px; font-size:14px; }
  .staff-elegido .chip { background:var(--activo); color:var(--activotxt); padding:4px 10px; border-radius:6px; font-weight:600; }
  .staff-elegido a { color:var(--azul); cursor:pointer; margin-left:10px; font-size:13px; }
  /* Resaltado fijo de la fila del último comprobante visto */
  #cuerpoCC tr { transition: background-color .3s ease; }
  #cuerpoCC tr.fila-foco { background:#fef9c3; }
  /* Indicador de carga */
  .cargando { color:var(--txt2); font-size:14px; padding:18px 2px; display:flex; align-items:center; gap:10px; }
  .cargando::before { content:""; width:16px; height:16px; border:2px solid var(--borde);
    border-top-color:var(--azul); border-radius:50%; animation:spin .7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>
<header>
  <div>
    <h1>Portal de Clientes</h1>
    <div class="sub">Mi cuenta</div>
  </div>
  <div id="sesion" class="hidden">
    <span class="topinfo" id="quien"></span>
    <button class="sec" id="btnSalir">Salir</button>
  </div>
</header>

<main>
  <!-- LOGIN -->
  <section id="vistaLogin" class="card">
    <h2>Ingresar</h2>
    <label>CUIT</label>
    <input id="loginIdent" type="text" placeholder="20123456789" />
    <label>Contraseña</label>
    <input id="loginPass" type="password" />
    <div style="margin-top:14px"><button id="btnIngresar">Ingresar</button></div>
    <div id="msgLogin" class="msg"></div>
  </section>

  <!-- PORTAL (cáscara con barra lateral) -->
  <section id="vistaPortal" class="hidden">
    <!-- Barra de consulta de staff (solo usuarios internos habilitados) -->
    <div id="staffBar" class="card hidden">
      <h2>Consulta de clientes</h2>
      <label>Buscar cliente (por razón social o CUIT)</label>
      <input id="staffBuscar" type="text" placeholder="Escribí para buscar…" autocomplete="off" />
      <div id="staffResultados" class="staff-res hidden"></div>
      <div id="staffElegido" class="staff-elegido hidden"></div>
    </div>

    <div class="layout">
      <nav class="sidebar">
        <a data-sec="cuenta" class="activo">Cuenta corriente</a>
        <a data-sec="datos">Mis datos</a>
      </nav>

      <div class="contenido">

        <!-- CUENTA CORRIENTE -->
        <div id="secCuenta" class="card seccion">

          <!-- Vista: cuenta corriente -->
          <div id="ccVista">
            <div class="resumen">
              <div>
                <h2 style="margin:0">Cuenta corriente</h2>
                <div class="sub" id="ccCod"></div>
              </div>
              <div class="montos">
                <div class="sub">Saldo total</div>
                <div id="saldoTotal" class="saldo">—</div>
                <div id="actualizacion" class="actu"></div>
              </div>
            </div>
            <div id="msgCuenta" class="msg"></div>
            <div id="avisoBases" class="aviso hidden"></div>
            <div id="ccCargando" class="cargando hidden">Cargando cuenta corriente…</div>
            <div id="leyendaBases" class="leyenda-bases hidden"></div>
            <table id="tablaCC" class="hidden">
              <thead>
                <tr>
                  <th>Base</th>
                  <th>Fecha</th>
                  <th>Comprobante</th>
                  <th>Vencimiento</th>
                  <th class="num">Total</th>
                  <th class="num">Saldo</th>
                  <th class="num">Saldo acumulado</th>
                </tr>
              </thead>
              <tbody id="cuerpoCC"></tbody>
            </table>
            <div id="ccVacio" class="vacio hidden">No hay comprobantes para mostrar.</div>
          </div>

          <!-- Vista: detalle de un comprobante -->
          <div id="ccDetalle" class="hidden">
            <span class="volver" id="btnVolverCC">← Volver a la cuenta corriente</span>
            <h2 id="detTitulo">Comprobante</h2>
            <div id="msgDet" class="msg"></div>
            <div id="detCargando" class="cargando hidden">Cargando comprobante…</div>
            <div class="detgrid" id="detEncabezado"></div>
            <table id="tablaItems" class="hidden">
              <thead>
                <tr>
                  <th>Descripción</th>
                  <th class="num">Cant.</th>
                  <th>U.</th>
                  <th class="num">Precio</th>
                  <th class="num">Bonif.</th>
                  <th class="num">IVA</th>
                  <th class="num">Importe</th>
                </tr>
              </thead>
              <tbody id="cuerpoItems"></tbody>
            </table>
            <div class="dettotales" id="detTotales"></div>
            <div style="margin-top:16px">
              <button class="sec" id="btnPdf" disabled title="Disponible más adelante">Descargar PDF (próximamente)</button>
            </div>
          </div>

        </div>

        <!-- MIS DATOS -->
        <div id="secDatos" class="card seccion hidden">
          <h2>Mis datos</h2>
          <div id="msgDatos" class="msg"></div>
          <dl class="datos">
            <div class="item"><dt>Razón social</dt><dd id="datoNombre">—</dd></div>
            <div class="item"><dt>Nombre de fantasía</dt><dd id="datoFantasia">—</dd></div>
            <div class="item"><dt>CUIT</dt><dd id="datoCuit">—</dd></div>
            <div class="item"><dt>Código de cliente</dt><dd id="datoCod">—</dd></div>
            <div class="item"><dt>Email</dt><dd id="datoEmail">—</dd></div>
            <div class="item"><dt>Teléfono</dt><dd id="datoTel">—</dd></div>
            <div class="item"><dt>Domicilio</dt><dd id="datoDom">—</dd></div>
            <div class="item"><dt>Condición impositiva (cód. BAS)</dt><dd id="datoCondicion">—</dd></div>
          </dl>
        </div>

      </div>
    </div>
  </section>
</main>

<script>
  const $ = id => document.getElementById(id);
  let token = localStorage.getItem("pc_token") || "";
  let ident = localStorage.getItem("pc_ident") || "";
  let codcli = localStorage.getItem("pc_codcli") || "";
  let razon = localStorage.getItem("pc_razon") || "";
  // Staff interno: puede buscar un cliente y ver su cuenta (pivotea por CUIT).
  let esStaff = localStorage.getItem("pc_staff") === "true";
  let clienteCuit = localStorage.getItem("pc_cli_cuit") || "";
  let clienteRazon = localStorage.getItem("pc_cli_razon") || "";

  // Tipos que NO son documentos (recibos, etc.): se muestran en la cuenta
  // corriente pero sin link al detalle (BAS no los devuelve como comprobante de venta).
  const TIPOS_EXCLUIDOS = ["RC"];

  // Comprobante cuyo detalle estamos mirando (para resaltarlo al volver).
  let ultimoComprobanteKey = "";
  // Cachés en memoria de la sesión.
  let cacheDetalle = {};   // detalle por comprobante (no cambia)
  let enVuelo = {};        // consultas de detalle en curso (dedupe)
  let ccCache = null;      // última cuenta corriente traída
  let datosCache = null;   // últimos "mis datos" traídos
  let basesVisibles = {};  // qué bases están tildadas en la cuenta corriente

  function mostrar(el, t, tipo) { el.textContent = t; el.className = "msg " + tipo; }
  function limpiar(el) { el.textContent = ""; el.className = "msg"; }
  function esc(s) {
    return (s || "").toString().replace(/&/g, "&amp;").replace(/</g, "&lt;")
      .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  function plata(n) {
    const x = Number(n) || 0;
    return "$ " + x.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }
  function num(n) {
    const x = Number(n) || 0;
    return x.toLocaleString("es-AR", { maximumFractionDigits: 2 });
  }
  function fecha(s) {
    if (!s) return "—";
    let d = String(s).split("T")[0].split(" ")[0];
    const m = d.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    return m ? (m[3] + "/" + m[2] + "/" + m[1]) : d;
  }
  function par(label, val) {
    return '<div class="par"><span class="parlbl">' + esc(label) + ':</span><span>' + esc(val) + '</span></div>';
  }
  function parTotal(label, val, grande) {
    return '<div class="par' + (grande ? ' grande' : '') + '"><span class="parlbl">'
      + esc(label) + ':</span><span>' + esc(val) + '</span></div>';
  }
  function esExcluido(tipo) {
    return TIPOS_EXCLUIDOS.includes((tipo || "").trim().toUpperCase());
  }
  function pad(v, len) {
    return (v === null || v === undefined ? "" : String(v)).trim().padStart(len, "0");
  }
  function comprobNombre(tipo, prefijo, numero) {
    return ((tipo || "").trim() + " " + pad(prefijo, 4) + "-" + pad(numero, 8)).trim();
  }
  function claveComprob(base, tipo, prefijo, numero) {
    return [base, tipo, prefijo, numero].join("|");
  }
  function limpiarFoco() {
    $("cuerpoCC").querySelectorAll("tr.fila-foco").forEach(f => f.classList.remove("fila-foco"));
  }
  function mostrarCargando(b) { $("detCargando").classList.toggle("hidden", !b); }
  function viendoListaCuenta() {
    return !$("secCuenta").classList.contains("hidden") && !$("ccVista").classList.contains("hidden");
  }

  // Trae el detalle de un comprobante. Usa caché y deduplica consultas en curso.
  function fetchDetalle(base, tipo, prefijo, numero) {
    const key = claveComprob(base, tipo, prefijo, numero);
    if (cacheDetalle[key]) return Promise.resolve(cacheDetalle[key]);
    if (enVuelo[key]) return enVuelo[key];

    const q = "?tipo=" + encodeURIComponent(tipo)
            + "&prefijo=" + encodeURIComponent(prefijo)
            + "&numero=" + encodeURIComponent(numero)
            + "&base=" + encodeURIComponent(base)
            + cuitQ("&");

    const p = (async () => {
      const r = await fetch("/api/mi-cuenta/comprobante" + q, { headers: { "Authorization": "Bearer " + token } });
      if (!r.ok) {
        const err = new Error("http");
        err.status = r.status;
        try { err.cuerpo = await r.json(); } catch (e) { err.cuerpo = {}; }
        throw err;
      }
      const d = await r.json();
      cacheDetalle[key] = d;
      return d;
    })();

    enVuelo[key] = p;
    p.finally(() => { delete enVuelo[key]; });
    return p;
  }

  function precargarDetalle(base, tipo, prefijo, numero) {
    const key = claveComprob(base, tipo, prefijo, numero);
    if (cacheDetalle[key] || enVuelo[key]) return;
    fetchDetalle(base, tipo, prefijo, numero).catch(() => {});
  }

  function pintarEncabezado() {
    $("quien").textContent = razon || ident;
    $("ccCod").textContent = codcli ? ("Código de cliente: " + codcli) : "";
  }

  function mostrarSeccion(sec) {
    const mapa = { cuenta: "secCuenta", datos: "secDatos" };
    document.querySelectorAll(".seccion").forEach(s => s.classList.add("hidden"));
    const destino = $(mapa[sec] || "secCuenta");
    if (destino) destino.classList.remove("hidden");

    document.querySelectorAll(".sidebar a").forEach(a =>
      a.classList.toggle("activo", a.dataset.sec === sec));

    if (sec === "cuenta") cargarCuenta();
    else if (sec === "datos") cargarDatos();
  }

  function actualizarVista() {
    if (token) {
      $("vistaLogin").classList.add("hidden");
      $("vistaPortal").classList.remove("hidden");
      $("sesion").classList.remove("hidden");
      $("staffBar").classList.toggle("hidden", !esStaff);
      pintarEncabezado();
      pintarClienteElegido();
      mostrarSeccion("cuenta");
    } else {
      $("vistaPortal").classList.add("hidden");
      $("vistaLogin").classList.remove("hidden");
      $("sesion").classList.add("hidden");
    }
  }

  async function ingresar() {
    limpiar($("msgLogin"));
    let r;
    try {
      r = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ identificador: $("loginIdent").value, password: $("loginPass").value })
      });
    } catch (e) { mostrar($("msgLogin"), "No se pudo conectar.", "err"); return; }

    if (!r.ok) { mostrar($("msgLogin"), "CUIT o contraseña incorrectos.", "err"); return; }
    const data = await r.json();

    token = data.token; ident = data.identificador;
    codcli = data.codigoCliente || ""; razon = data.razonSocial || "";
    esStaff = (data.tipo === "Interno" && data.accedePortal === true);
    // Al loguear no hay cliente elegido todavía (el staff lo busca).
    clienteCuit = ""; clienteRazon = "";
    localStorage.setItem("pc_token", token);
    localStorage.setItem("pc_ident", ident);
    localStorage.setItem("pc_codcli", codcli);
    localStorage.setItem("pc_razon", razon);
    localStorage.setItem("pc_staff", esStaff ? "true" : "false");
    localStorage.removeItem("pc_cli_cuit");
    localStorage.removeItem("pc_cli_razon");
    actualizarVista();
  }

  function salir() {
    token = ""; ident = ""; codcli = ""; razon = "";
    esStaff = false; clienteCuit = ""; clienteRazon = "";
    ultimoComprobanteKey = ""; cacheDetalle = {}; enVuelo = {}; ccCache = null; datosCache = null;
    basesVisibles = {};
    ["pc_token", "pc_ident", "pc_codcli", "pc_razon", "pc_staff", "pc_cli_cuit", "pc_cli_razon"].forEach(k => localStorage.removeItem(k));
    actualizarVista();
  }

  // ---------- Mis datos ----------
  function pintarDatos(d) {
    if (d.razonSocial) $("datoNombre").textContent = d.razonSocial;
    $("datoFantasia").textContent = d.nombreFantasia || "—";
    if (d.cuit) $("datoCuit").textContent = d.cuit;
    if (d.codigoCliente) $("datoCod").textContent = d.codigoCliente;
    $("datoEmail").textContent = d.email || "—";
    $("datoCondicion").textContent = d.condicionImpositiva || "—";
    if (d.domicilio) {
      $("datoTel").textContent = d.domicilio.telefono || "—";
      const partes = [
        d.domicilio.calle,
        d.domicilio.localidad,
        d.domicilio.codigoPostal ? ("CP " + d.domicilio.codigoPostal) : ""
      ].filter(Boolean);
      $("datoDom").textContent = partes.join(", ") || "—";
    } else {
      $("datoTel").textContent = "—";
      $("datoDom").textContent = "—";
    }
  }

  function cargarDatos() {
    if (esStaff && !clienteCuit) {
      ["datoNombre","datoFantasia","datoCuit","datoCod","datoEmail","datoTel","datoDom","datoCondicion"]
        .forEach(id => $(id).textContent = "—");
      mostrar($("msgDatos"), "Elegí un cliente para ver sus datos.", "ok");
      return;
    }
    if (!esStaff) {
      $("datoNombre").textContent = razon || "—";
      $("datoCuit").textContent = ident || "—";
      $("datoCod").textContent = codcli || "—";
    }
    if (datosCache) pintarDatos(datosCache);
    limpiar($("msgDatos"));
    actualizarDatosFondo(!datosCache);
  }

  async function actualizarDatosFondo(foreground) {
    let r;
    try {
      r = await fetch("/api/mi-cuenta/datos" + cuitQ("?"), { headers: { "Authorization": "Bearer " + token } });
    } catch (e) { return; }

    if (r.status === 401) { salir(); return; }
    if (!r.ok) {
      if (foreground) {
        const d = await r.json().catch(() => ({}));
        mostrar($("msgDatos"), d.mensaje || "No se pudieron cargar todos los datos.", "err");
      }
      return;
    }
    const d = await r.json();
    datosCache = d;
    if (!$("secDatos").classList.contains("hidden")) pintarDatos(d);
  }

  // ---------- Cuenta corriente ----------
  // Bases distintas que aparecen en los movimientos traídos.
  function basesConDatos(d) {
    const lista = [];
    for (const c of (d.comprobantes || [])) {
      if (c.baseNombre && !lista.includes(c.baseNombre)) lista.push(c.baseNombre);
    }
    return lista;
  }

  // Arma un tilde por base (una por cada base con datos). Por defecto van
  // tildadas; los cambios del usuario se preservan entre refrescos de fondo.
  function construirControlesBases(d) {
    const cont = $("leyendaBases");
    const bases = basesConDatos(d);
    if (bases.length === 0) { cont.innerHTML = ""; cont.classList.add("hidden"); return; }

    for (const b of bases) if (basesVisibles[b] === undefined) basesVisibles[b] = true;

    cont.innerHTML = '<span>Ver bases:</span>' + bases.map(b =>
      '<label class="base-check"><input type="checkbox" data-base="' + esc(b) + '"'
        + (basesVisibles[b] ? ' checked' : '') + '> '
        + '<span class="basebadge ' + esc(b) + '">' + esc(b) + '</span></label>'
    ).join("");
    cont.classList.remove("hidden");

    cont.querySelectorAll('input[type="checkbox"]').forEach(chk => {
      chk.addEventListener("change", () => {
        basesVisibles[chk.dataset.base] = chk.checked;
        renderMovimientos();
      });
    });
  }

  function pintarCuenta(d) {
    $("ccCargando").classList.add("hidden");
    limpiar($("msgCuenta"));

    // Aviso si alguna base no respondió (mostramos las que sí, con nota).
    const basesFallidas = (d.bases || []).filter(b => b && b.ok === false);
    const avisoEl = $("avisoBases");
    if (basesFallidas.length > 0) {
      avisoEl.textContent = "No se pudo consultar: "
        + basesFallidas.map(b => b.baseNombre).join(", ")
        + ". Se muestran las bases disponibles.";
      avisoEl.classList.remove("hidden");
    } else {
      avisoEl.classList.add("hidden");
    }

    construirControlesBases(d);
    renderMovimientos();
  }

  // Pinta la tabla y el saldo total a partir de ccCache, filtrando por las bases
  // tildadas y recalculando total y acumulado sobre lo visible.
  function renderMovimientos() {
    const d = ccCache;
    if (!d) return;

    const todos = d.comprobantes || [];
    const comps = todos.filter(c => basesVisibles[c.baseNombre] !== false);

    const total = comps.reduce((s, c) => s + (Number(c.saldo) || 0), 0);
    $("saldoTotal").textContent = plata(total);
    $("saldoTotal").className = "saldo " + (Math.abs(total) < 0.005 ? "aldia" : "deuda");
    $("actualizacion").textContent = d.fechaActualizacion ? ("Actualizado: " + fecha(d.fechaActualizacion)) : "";

    const cuerpo = $("cuerpoCC");
    cuerpo.innerHTML = "";

    if (comps.length === 0) {
      $("tablaCC").classList.add("hidden");
      $("ccVacio").textContent = todos.length > 0
        ? "Seleccioná al menos una base para ver movimientos."
        : "No hay comprobantes para mostrar.";
      $("ccVacio").classList.remove("hidden");
      return;
    }
    $("ccVacio").classList.add("hidden");

    let acumulado = 0;
    for (const c of comps) {
      acumulado += Number(c.saldo) || 0;
      const tr = document.createElement("tr");
      tr.dataset.key = claveComprob(c.baseNombre, c.tipo, c.prefijo, c.numero);
      if (c.baseNombre) tr.classList.add("base-" + c.baseNombre);
      if (tr.dataset.key === ultimoComprobanteKey) tr.classList.add("fila-foco");

      const nombre = comprobNombre(c.tipo, c.prefijo, c.numero);
      const celdaComp = esExcluido(c.tipo)
        ? esc(nombre)
        : '<a class="lnk-comp" data-base="' + esc(c.baseNombre)
            + '" data-tipo="' + esc(c.tipo)
            + '" data-prefijo="' + esc(c.prefijo) + '" data-numero="' + esc(c.numero)
            + '">' + esc(nombre) + '</a>';

      let venc = esc(fecha(c.vencimiento));
      if (Number(c.cuotas) > 1) venc += ' <span class="cuotas">(' + c.cuotas + ' cuotas)</span>';

      tr.innerHTML =
          '<td><span class="basebadge ' + esc(c.baseNombre) + '">' + esc(c.baseNombre) + '</span></td>'
        + '<td>' + esc(fecha(c.fecha)) + '</td>'
        + '<td>' + celdaComp + '</td>'
        + '<td>' + venc + '</td>'
        + '<td class="num">' + plata(c.total) + '</td>'
        + '<td class="num">' + plata(c.saldo) + '</td>'
        + '<td class="acum">' + plata(acumulado) + '</td>';
      cuerpo.appendChild(tr);
    }
    $("tablaCC").classList.remove("hidden");

    // Precarga al pasar el mouse.
    cuerpo.querySelectorAll("a.lnk-comp").forEach(a => {
      a.addEventListener("mouseenter", () => {
        a._ht = setTimeout(() =>
          precargarDetalle(a.dataset.base, a.dataset.tipo, a.dataset.prefijo, a.dataset.numero), 150);
      });
      a.addEventListener("mouseleave", () => clearTimeout(a._ht));
    });
  }

  function cargarCuenta() {
    $("ccDetalle").classList.add("hidden");
    $("ccVista").classList.remove("hidden");

    if (esStaff && !clienteCuit) {
      // Staff sin cliente elegido: no consultamos, pedimos que busque.
      $("ccCargando").classList.add("hidden");
      $("tablaCC").classList.add("hidden");
      $("leyendaBases").classList.add("hidden");
      $("saldoTotal").textContent = "—";
      $("saldoTotal").className = "saldo";
      $("actualizacion").textContent = "";
      $("ccVacio").textContent = "Buscá y elegí un cliente para ver su cuenta corriente.";
      $("ccVacio").classList.remove("hidden");
      return;
    }

    if (ccCache) {
      pintarCuenta(ccCache);
      actualizarCuentaFondo(false);
    } else {
      actualizarCuentaFondo(true);
    }
  }

  async function actualizarCuentaFondo(foreground) {
    if (foreground) {
      limpiar($("msgCuenta"));
      $("tablaCC").classList.add("hidden");
      $("ccVacio").classList.add("hidden");
      $("saldoTotal").textContent = "—";
      $("saldoTotal").className = "saldo";
      $("actualizacion").textContent = "";
      $("ccCargando").classList.remove("hidden");
    }

    let r;
    try {
      r = await fetch("/api/mi-cuenta/cuenta-corriente" + cuitQ("?"), { headers: { "Authorization": "Bearer " + token } });
    } catch (e) {
      if (foreground) { $("ccCargando").classList.add("hidden"); mostrar($("msgCuenta"), "No se pudo conectar.", "err"); }
      return;
    }

    if (r.status === 401) { salir(); return; }
    if (!r.ok) {
      if (foreground) {
        $("ccCargando").classList.add("hidden");
        const d = await r.json().catch(() => ({}));
        mostrar($("msgCuenta"),
          d.mensaje || (r.status === 400 ? "Tu usuario no tiene cuenta corriente de cliente." : "No se pudo consultar la cuenta corriente."),
          "err");
      }
      return;
    }

    const d = await r.json();
    ccCache = d;
    if (foreground || viendoListaCuenta()) pintarCuenta(d);
  }

  // ---------- Detalle de comprobante ----------
  function prepararDetalleVacio(tipo, prefijo, numero) {
    $("detTitulo").textContent = comprobNombre(tipo, prefijo, numero) || "Comprobante";
    $("detEncabezado").innerHTML = "";
    $("detTotales").innerHTML = "";
    $("cuerpoItems").innerHTML = "";
    $("tablaItems").classList.add("hidden");
  }

  function pintarDetalle(d) {
    $("detTitulo").textContent = comprobNombre(d.tipo, d.prefijo, d.numero) || "Comprobante";
    const enc = [par("Fecha", fecha(d.fecha))];
    if (d.baseNombre) enc.push(par("Base", d.baseNombre));
    if (d.moneda) enc.push(par("Moneda", d.moneda));
    if (d.observacion) enc.push(par("Observación", d.observacion));
    $("detEncabezado").innerHTML = enc.join("");

    const items = d.items || [];
    const cuerpo = $("cuerpoItems");
    cuerpo.innerHTML = "";
    for (const it of items) {
      const tr = document.createElement("tr");
      tr.innerHTML =
          '<td>' + esc(it.descripcion) + '</td>'
        + '<td class="num">' + num(it.cantidad) + '</td>'
        + '<td>' + esc(it.unidad) + '</td>'
        + '<td class="num">' + plata(it.precio) + '</td>'
        + '<td class="num">' + num(it.bonificacion) + '</td>'
        + '<td class="num">' + plata(it.iva) + '</td>'
        + '<td class="num">' + plata(it.importe) + '</td>';
      cuerpo.appendChild(tr);
    }
    $("tablaItems").classList.toggle("hidden", items.length === 0);

    // Desglose de impuestos (cada línea aparece solo si tiene monto).
    const tot = [];
    const im = d.impuestos;
    if (im) {
      if (Number(im.netoGravado))    tot.push(parTotal("Neto gravado", plata(im.netoGravado)));
      if (Number(im.iva))            tot.push(parTotal("IVA", plata(im.iva)));
      if (Number(im.ivaAdicional))   tot.push(parTotal("IVA adicional", plata(im.ivaAdicional)));
      if (Number(im.percepcionIva))  tot.push(parTotal("Percep. IVA", plata(im.percepcionIva)));
      if (Number(im.percepcionIibb)) tot.push(parTotal("Percep. IIBB", plata(im.percepcionIibb)));
      if (Number(im.internos))       tot.push(parTotal("Imp. internos", plata(im.internos)));
    }
    tot.push(parTotal("Total", plata(d.total), true));
    if (d.saldo !== undefined && d.saldo !== null) tot.push(parTotal("Saldo", plata(d.saldo)));
    $("detTotales").innerHTML = tot.join("");
  }

  async function verComprobante(base, tipo, prefijo, numero) {
    limpiarFoco();
    const key = claveComprob(base, tipo, prefijo, numero);
    ultimoComprobanteKey = key;

    $("ccVista").classList.add("hidden");
    $("ccDetalle").classList.remove("hidden");
    limpiar($("msgDet"));
    window.scrollTo({ top: 0, behavior: "auto" });

    if (cacheDetalle[key]) { mostrarCargando(false); pintarDetalle(cacheDetalle[key]); return; }

    prepararDetalleVacio(tipo, prefijo, numero);
    mostrarCargando(true);

    let d;
    try {
      d = await fetchDetalle(base, tipo, prefijo, numero);
    } catch (err) {
      if (ultimoComprobanteKey !== key) return;
      mostrarCargando(false);
      if (err.status === 401) { salir(); return; }
      const msg = err.status
        ? ((err.cuerpo && err.cuerpo.mensaje) || "No se pudo cargar el comprobante.")
        : "No se pudo conectar.";
      mostrar($("msgDet"), msg, "err");
      return;
    }

    if (ultimoComprobanteKey !== key) return;
    mostrarCargando(false);
    pintarDetalle(d);
  }

  function volverACuenta() {
    $("ccDetalle").classList.add("hidden");
    $("ccVista").classList.remove("hidden");
    if (!ultimoComprobanteKey) return;

    let objetivo = null;
    $("cuerpoCC").querySelectorAll("tr").forEach(f => {
      if (f.dataset.key === ultimoComprobanteKey) objetivo = f;
    });
    if (objetivo) {
      objetivo.scrollIntoView({ behavior: "smooth", block: "center" });
      objetivo.classList.add("fila-foco");
    }
  }

  // ---------- Staff: búsqueda de clientes ----------
  let staffTimer = null;

  // Devuelve el sufijo ?cuit=/&cuit= cuando el staff tiene un cliente elegido; "" si no.
  function cuitQ(sep) {
    return (esStaff && clienteCuit) ? (sep + "cuit=" + encodeURIComponent(clienteCuit)) : "";
  }

  function pintarClienteElegido() {
    const cont = $("staffElegido");
    if (!esStaff) { cont.classList.add("hidden"); return; }
    if (clienteCuit) {
      cont.innerHTML = 'Viendo la cuenta de <span class="chip">' + esc(clienteRazon || clienteCuit)
        + '</span> <span class="sub">(' + esc(clienteCuit) + ')</span>'
        + '<a id="staffCambiar">Cambiar cliente</a>';
      const cambiar = $("staffCambiar");
      if (cambiar) cambiar.addEventListener("click", () => { $("staffBuscar").value = ""; $("staffBuscar").focus(); });
    } else {
      cont.innerHTML = '<span class="sub">Buscá un cliente por razón social o CUIT.</span>';
    }
    cont.classList.remove("hidden");
  }

  async function buscarClientesStaff() {
    const q = $("staffBuscar").value.trim();
    const cont = $("staffResultados");
    if (q.length < 2) { cont.classList.add("hidden"); cont.innerHTML = ""; return; }
    let r;
    try {
      r = await fetch("/api/mi-cuenta/buscar-clientes?q=" + encodeURIComponent(q), { headers: { "Authorization": "Bearer " + token } });
    } catch (e) { return; }
    if (r.status === 401) { salir(); return; }
    if (!r.ok) { cont.innerHTML = '<div class="vacio">No se pudo buscar.</div>'; cont.classList.remove("hidden"); return; }
    const d = await r.json();
    const items = d.items || [];
    if (items.length === 0) {
      cont.innerHTML = '<div class="vacio">Sin resultados para “' + esc(q) + '”.</div>';
    } else {
      cont.innerHTML = items.map(it =>
        '<div class="item" data-cuit="' + esc(it.cuit) + '" data-razon="' + esc(it.razonSocial) + '">'
        + esc(it.razonSocial || "(sin razón social)")
        + '<span class="cuit">' + esc(it.cuit) + '</span></div>'
      ).join("") + (d.hayMas ? '<div class="vacio">Afiná la búsqueda para ver más.</div>' : "");
    }
    cont.classList.remove("hidden");
    cont.querySelectorAll(".item").forEach(el =>
      el.addEventListener("click", () => elegirCliente(el.dataset.cuit, el.dataset.razon)));
  }

  function elegirCliente(cuit, razonCli) {
    clienteCuit = cuit || "";
    clienteRazon = razonCli || "";
    localStorage.setItem("pc_cli_cuit", clienteCuit);
    localStorage.setItem("pc_cli_razon", clienteRazon);
    // Reiniciamos las cachés: eran del cliente anterior.
    ccCache = null; datosCache = null; cacheDetalle = {}; enVuelo = {};
    basesVisibles = {}; ultimoComprobanteKey = "";
    $("staffResultados").classList.add("hidden");
    $("staffResultados").innerHTML = "";
    $("staffBuscar").value = "";
    pintarClienteElegido();
    mostrarSeccion("cuenta");
  }

  $("btnIngresar").addEventListener("click", ingresar);
  $("btnSalir").addEventListener("click", salir);
  $("staffBuscar").addEventListener("input", () => {
    clearTimeout(staffTimer);
    staffTimer = setTimeout(buscarClientesStaff, 250);
  });
  $("loginPass").addEventListener("keydown", e => { if (e.key === "Enter") ingresar(); });
  document.querySelectorAll(".sidebar a").forEach(a =>
    a.addEventListener("click", () => mostrarSeccion(a.dataset.sec)));
  $("btnVolverCC").addEventListener("click", volverACuenta);
  $("cuerpoCC").addEventListener("click", e => {
    const a = e.target.closest("a.lnk-comp");
    if (!a) return;
    verComprobante(a.dataset.base, a.dataset.tipo, a.dataset.prefijo, a.dataset.numero);
  });

  actualizarVista();
</script>
</body>
</html>
